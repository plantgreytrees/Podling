---
source: crates/podling-types/tests/schema_snapshot.rs
expression: schema
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EpisodeSpec",
  "type": "object",
  "properties": {
    "analysers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/AnalyserConfig"
      }
    },
    "asr": {
      "description": "Transcribes each synthesised chunk to check it against the script.",
      "anyOf": [
        {
          "$ref": "#/$defs/AsrConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "cast": {
      "description": "The speakers, each with a pinned voice. Required by `[tts]`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CastMember"
      }
    },
    "embedding": {
      "description": "Embeds claims and source sentences so the NLI stages can pick which\npairs to compare. Needs `nli` too; without both, claims merge only by\nexact wording and every piece of evidence is the claim's own extraction.",
      "anyOf": [
        {
          "$ref": "#/$defs/EmbeddingConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "llm": {
      "$ref": "#/$defs/LlmConfig"
    },
    "mix": {
      "description": "Gaps between turns and an optional compressed copy. Needs `[tts]`.",
      "anyOf": [
        {
          "$ref": "#/$defs/MixConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "$ref": "#/$defs/Mode",
      "default": "non_fiction"
    },
    "nli": {
      "description": "Judges whether one text entails or contradicts another. Needs\n`embedding` too.",
      "anyOf": [
        {
          "$ref": "#/$defs/NliConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceSpec"
      }
    },
    "target_minutes": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "tts": {
      "description": "Turns the script into audio. Needs `[[cast]]` and `[asr]` too; without\nit, the run stops at the script.",
      "anyOf": [
        {
          "$ref": "#/$defs/TtsConfig"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "title",
    "topic",
    "target_minutes",
    "sources",
    "llm"
  ],
  "$defs": {
    "AnalyserConfig": {
      "oneOf": [
        {
          "description": "Checks every quote against its source, word for word.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "quote_verifier"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Warns on a turn that states a number or a year but cites no claim:\nthe likeliest place for banter to slip in an unsourced fact.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uncited_figures"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "AsrConfig": {
      "oneOf": [
        {
          "description": "Deterministic offline stand-in that hears exactly what was meant.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fake"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Whisper run on the CPU, e.g. `openai/whisper-base.en`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "whisper"
            },
            "max_wer_pm": {
              "description": "A chunk passes when its word error rate is at most this, in\nthousandths (80 = 8%).",
              "$ref": "#/$defs/PerMille",
              "default": 80
            },
            "model_dir": {
              "description": "Directory holding the model's `config.json`, `tokenizer.json` and\n`model.safetensors`. A relative path is resolved against the\nepisode file's directory.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "model_dir"
          ]
        }
      ]
    },
    "CastMember": {
      "description": "One speaker in `[[cast]]`.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SpeakerId"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "description": "Free-form role, e.g. `host` or `narrator`.",
          "type": "string"
        },
        "voice": {
          "$ref": "#/$defs/VoiceRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "voice"
      ]
    },
    "DataPolicy": {
      "description": "What a hosted server does with the text Podling sends it, as the episode's\nauthor declares it. Source text and claims go to the `[llm]` and\n`[embedding]` servers, so a server that isn't local must be declared.",
      "oneOf": [
        {
          "description": "The endpoint neither trains on nor retains inputs or outputs (zero\ndata retention). Declare it only for an endpoint whose terms, or an\naccount setting, guarantee that.",
          "type": "string",
          "const": "zero_retention"
        }
      ]
    },
    "EmbeddingConfig": {
      "oneOf": [
        {
          "description": "Deterministic offline stand-in: a hashed bag of words.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fake"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Any server that speaks the OpenAI embeddings protocol\n(`POST {base_url}/embeddings`), e.g. Ollama with `nomic-embed-text`.",
          "type": "object",
          "properties": {
            "api_key_env": {
              "description": "Name of the environment variable holding the API key, never the\nkey itself. Leave unset for local servers that need none.",
              "type": [
                "string",
                "null"
              ]
            },
            "base_url": {
              "description": "Base URL up to and including the version segment, e.g.\n`http://localhost:11434/v1`. Must be `http://` or `https://`.",
              "type": "string"
            },
            "data_policy": {
              "description": "What the server does with the requests; required for a hosted\n`base_url`, as for `[llm]`.",
              "anyOf": [
                {
                  "$ref": "#/$defs/DataPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "open_ai_compat"
            },
            "model": {
              "description": "Model name as the server knows it, e.g. `nomic-embed-text`.",
              "type": "string"
            },
            "timeout_secs": {
              "description": "Per-request timeout in seconds; the provider's default when unset.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "unload_after": {
              "description": "Ask Ollama to unload the model once grounding is done, so the GPU\nis free for the next model. Ollama only: `base_url` must end in\n`/v1`.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "base_url",
            "model"
          ]
        }
      ]
    },
    "Encode": {
      "description": "A compressed format for the episode, beside `episode.wav`.",
      "oneOf": [
        {
          "description": "Ogg Opus, 64 kbit/s: small, and what podcast apps play natively.",
          "type": "string",
          "const": "opus"
        },
        {
          "description": "MP3, VBR around 130 kbit/s: plays everywhere.",
          "type": "string",
          "const": "mp3"
        }
      ]
    },
    "Gaps": {
      "description": "Milliseconds of silence before a turn, by its pace; `interrupt` is how far\nan interrupting turn overlaps the one before it. Each key is optional.",
      "type": "object",
      "properties": {
        "beat": {
          "type": "integer",
          "format": "uint16",
          "default": 600,
          "maximum": 65535,
          "minimum": 0
        },
        "interrupt": {
          "type": "integer",
          "format": "uint16",
          "default": 150,
          "maximum": 65535,
          "minimum": 0
        },
        "long_pause": {
          "type": "integer",
          "format": "uint16",
          "default": 1000,
          "maximum": 65535,
          "minimum": 0
        },
        "normal": {
          "type": "integer",
          "format": "uint16",
          "default": 300,
          "maximum": 65535,
          "minimum": 0
        },
        "quick": {
          "type": "integer",
          "format": "uint16",
          "default": 120,
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Lexicon": {
      "description": "Names and how to say them, e.g. `[tts.pronounce]` in an episode.\nNames are matched as whole words, case-sensitively.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Pronunciation"
      }
    },
    "LlmConfig": {
      "oneOf": [
        {
          "description": "Deterministic offline stand-in, for development and tests.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fake"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Any server that speaks the OpenAI chat-completions protocol: Ollama,\nllama.cpp `llama-server`, vLLM, LM Studio, OpenAI itself.\n\nThere is deliberately no field for the key itself, only the name of the\nenvironment variable that holds it, so an episode file stays free of\nsecrets and `deny_unknown_fields` rejects a pasted `api_key = \"...\"`.",
          "type": "object",
          "properties": {
            "api_key_env": {
              "description": "Name of the environment variable holding the API key. Leave unset\nfor local servers that need none.",
              "type": [
                "string",
                "null"
              ]
            },
            "base_url": {
              "description": "Base URL up to and including the version segment, e.g.\n`http://localhost:11434/v1`. Must be `http://` or `https://`.",
              "type": "string"
            },
            "data_policy": {
              "description": "What the server does with the requests. Podling sends nothing to a\nhosted `base_url` (anything but `localhost` or a loopback or\nprivate IP address) unless this is declared.",
              "anyOf": [
                {
                  "$ref": "#/$defs/DataPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "open_ai_compat"
            },
            "max_output_tokens": {
              "description": "Cap on generated tokens per request; the server's default when unset.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "model": {
              "description": "Model name as the server knows it, e.g. `llama3.1:8b`.",
              "type": "string"
            },
            "temperature": {
              "description": "Sampling temperature; the server's default when unset.",
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "timeout_secs": {
              "description": "Per-request timeout in seconds; the provider's default when unset.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "unload_after": {
              "description": "Ask Ollama to unload the model once the script is written, so the\nGPU is free for text-to-speech. Ollama only: `base_url` must end\nin `/v1`.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "base_url",
            "model"
          ]
        }
      ]
    },
    "MixConfig": {
      "description": "How the synthesised chunks are put together into one episode file.\nApplies to every TTS backend, so it is a section of its own rather than\npart of `[tts]` (whose fields depend on its `kind`).",
      "type": "object",
      "properties": {
        "encode": {
          "description": "Also writes the episode in a compressed format, through `ffmpeg`\n(which must be on `PATH`). `episode.wav` is always written.",
          "anyOf": [
            {
              "$ref": "#/$defs/Encode"
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps_ms": {
          "description": "Silence before a turn, by the turn's pace.",
          "$ref": "#/$defs/Gaps",
          "default": {
            "beat": 600,
            "interrupt": 150,
            "long_pause": 1000,
            "normal": 300,
            "quick": 120
          }
        }
      },
      "additionalProperties": false
    },
    "Mode": {
      "description": "What kind of episode to make. Only non-fiction exists today; fiction modes\nare planned, so matches on this enum must stay open-ended.",
      "type": "string",
      "enum": [
        "non_fiction"
      ]
    },
    "NliConfig": {
      "oneOf": [
        {
          "description": "Deterministic offline stand-in: word containment, with a changed\nnumber counted as a contradiction.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fake"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "A local DeBERTa-v3 NLI cross-encoder, run on the CPU, e.g.\n`cross-encoder/nli-deberta-v3-base`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cross_encoder"
            },
            "model_dir": {
              "description": "Directory holding the model's `config.json`, `tokenizer.json` and\n`model.safetensors`. A relative path is resolved against the\nepisode file's directory.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "model_dir"
          ]
        }
      ]
    },
    "PerMille": {
      "description": "A score from 0 to 1 in thousandths.",
      "type": "integer",
      "maximum": 1000,
      "minimum": 0
    },
    "Pronunciation": {
      "description": "How one name is said: the respelling the TTS model is given instead of\nthe name, and what speech recognition may write when it hears it.\n\nRespell names the model gets wrong, never common words (respelling one\nmade it worse in the word test). A respelling is one unhyphenated word\nper word of the name: a hyphen splits the word when spoken.",
      "anyOf": [
        {
          "description": "The respelling only.",
          "type": "string"
        },
        {
          "$ref": "#/$defs/PronunciationTable"
        }
      ]
    },
    "PronunciationTable": {
      "type": "object",
      "properties": {
        "heard": {
          "description": "What speech recognition may write for the name; each is read as the\nname when the audio is checked.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "say": {
          "description": "The respelling the TTS model is given.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "say"
      ]
    },
    "SourceSpec": {
      "oneOf": [
        {
          "description": "Every `.md` / `.txt` file directly under `root`. A relative `root` is\nresolved against the episode file's directory.",
          "type": "object",
          "properties": {
            "independence_group": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "local_files"
            },
            "root": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "root",
            "independence_group"
          ]
        }
      ]
    },
    "SpeakerId": {
      "description": "A human-readable speaker handle such as `host` or `guest`.",
      "type": "string"
    },
    "TtsConfig": {
      "oneOf": [
        {
          "description": "Deterministic offline stand-in: a sine tone per speaker.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fake"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "A model worker started from a profile in the user-level\n`~/.config/podling/sidecars.toml`. The episode names the profile\nonly, so a shared episode file can never choose a program to run.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sidecar"
            },
            "max_retries": {
              "description": "Extra attempts for a chunk that fails verification.",
              "type": "integer",
              "format": "uint8",
              "default": 2,
              "maximum": 255,
              "minimum": 0
            },
            "pronounce": {
              "description": "Names the model mispronounces, each with a respelling, as\n`[tts.pronounce]`. Merged over the user-level `pronounce.toml`\nbeside `sidecars.toml`; this list wins per name. The speech check\nand the quotes keep the original words.",
              "$ref": "#/$defs/Lexicon"
            },
            "sidecar": {
              "description": "Profile name in `sidecars.toml`, e.g. `qwen3-tts`.",
              "type": "string"
            },
            "takes": {
              "description": "Takes made of each banter beat; the best passing one wins.",
              "type": "integer",
              "format": "uint8",
              "default": 2,
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sidecar"
          ]
        }
      ]
    },
    "VoiceRef": {
      "description": "A reference clip that pins a speaker's voice; every chunk is conditioned\non it.\n\nThe licence is required because voice clips are where non-commercial\nterms sneak in, and it is copied into the audio manifest. Deserialisation\nruns the same checks as [`VoiceRef::new`].",
      "type": "object",
      "properties": {
        "licence": {
          "description": "SPDX identifier of the clip's licence, e.g. `CC0-1.0` or `CC-BY-4.0`.",
          "type": "string"
        },
        "reference": {
          "description": "The clip (WAV). A relative path is resolved against the episode\nfile's directory.",
          "type": "string"
        },
        "transcript": {
          "description": "Exactly what is said in the clip; voice-cloning models need it.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "reference",
        "transcript",
        "licence"
      ]
    }
  }
}
