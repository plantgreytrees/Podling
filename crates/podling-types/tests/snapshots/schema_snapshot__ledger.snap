---
source: crates/podling-types/tests/schema_snapshot.rs
expression: schema
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "type": "object",
  "properties": {
    "body": {
      "$ref": "#/$defs/Ledger"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactKind"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "kind",
    "body"
  ],
  "$defs": {
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "episode",
        "documents",
        "chunks",
        "claims",
        "ledger",
        "script",
        "analysis"
      ]
    },
    "ChunkId": {
      "description": "Identifies a chunk by its document and span.",
      "$ref": "#/$defs/ContentHash"
    },
    "Claim": {
      "description": "A single checkable statement. Claims whose text differs only in case or\nwhitespace share an id, so the same fact from two sources merges into one\nclaim with two pieces of evidence.",
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "id": {
          "$ref": "#/$defs/ClaimId"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "evidence"
      ]
    },
    "ClaimId": {
      "description": "Identifies a claim by its normalised text.",
      "$ref": "#/$defs/ContentHash"
    },
    "ClaimStatus": {
      "description": "Group names are sorted and de-duplicated in every variant.",
      "oneOf": [
        {
          "description": "Supported by at least two independent groups; nobody contradicts it.",
          "type": "object",
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "type": "string",
              "const": "corroborated"
            }
          },
          "required": [
            "status",
            "groups"
          ]
        },
        {
          "description": "Supported by exactly one independent group; nobody contradicts it.",
          "type": "object",
          "properties": {
            "group": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "single_source"
            }
          },
          "required": [
            "status",
            "group"
          ]
        },
        {
          "description": "At least one group contradicts it. `supporting` may be empty.",
          "type": "object",
          "properties": {
            "contradicting": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "type": "string",
              "const": "contested"
            },
            "supporting": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "supporting",
            "contradicting"
          ]
        },
        {
          "description": "No evidence either way.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unsupported"
            }
          },
          "required": [
            "status"
          ]
        }
      ]
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Evidence": {
      "description": "One chunk's position on a claim.",
      "type": "object",
      "properties": {
        "chunk": {
          "$ref": "#/$defs/ChunkId"
        },
        "independence_group": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceId"
        },
        "stance": {
          "$ref": "#/$defs/Stance"
        }
      },
      "required": [
        "chunk",
        "source",
        "independence_group",
        "stance"
      ]
    },
    "Ledger": {
      "description": "Every entry's status is `classify(&entry.claim)`; deserialisation rejects a\nledger whose stored status disagrees with its evidence.",
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LedgerEntry"
          }
        }
      },
      "required": [
        "entries"
      ]
    },
    "LedgerEntry": {
      "type": "object",
      "properties": {
        "claim": {
          "$ref": "#/$defs/Claim"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        }
      },
      "required": [
        "claim",
        "status"
      ]
    },
    "SourceId": {
      "description": "Identifies a source (connector + locator), independent of its content.",
      "$ref": "#/$defs/ContentHash"
    },
    "Stance": {
      "type": "string",
      "enum": [
        "supports",
        "contradicts"
      ]
    }
  }
}
